theorem finKernel_27_3 {q l : ℝ} (hq0 : 0 ≤ q) (hq : q ≤ 1/3)
    (hl0 : 0 < l) (hlr : l < q + 3/27) :
    0 ≤ diagKernel 27 3 q l := by
  have hpos : (0:ℝ) ≤ ((27:ℤ):ℝ) * q + ((3:ℤ):ℝ) - ((27:ℤ):ℝ) * l := by
    push_cast; linarith [hlr]
  have hcert : 0 ≤ certReal (27:ℤ) (3:ℤ) 20 20 q l grid_27_3 :=
    certReal_nonneg (27:ℤ) (3:ℤ) 20 20 (by linarith) (by linarith) hl0.le hpos grid_27_3
  have hdata : eqBP (smulBP (4052555153018976267 : ℤ) (dkClearedBP 27 3))
      (hornerBP (27:ℤ) (3:ℤ) 20 20 grid_27_3) = true := by
    decide +kernel
  have hbridge : bpEval q l (smulBP (4052555153018976267 : ℤ) (dkClearedBP 27 3))
      = bpEval q l (hornerBP (27:ℤ) (3:ℤ) 20 20 grid_27_3) := eqBP_sound q l _ _ hdata
  rw [eval_smulBP, eval_dkClearedBP 27 3 (by norm_num) (by norm_num) q l,
      eval_hornerBP (27:ℤ) (3:ℤ) 20 20 q l grid_27_3] at hbridge
  have hqt : (0:ℝ) < q + ((3:ℕ):ℝ) / ((27:ℕ):ℝ) := by
    have : (0:ℝ) < ((3:ℕ):ℝ) / ((27:ℕ):ℝ) := by positivity
    linarith [hq0]
  have hL : (0:ℝ) < ((4052555153018976267:ℤ):ℝ) := by norm_num
  have hA0 : (0:ℝ) < ((3:ℕ):ℝ) * ((27:ℕ):ℝ) ^ (27 - 2 * 3 - 1)
      * (q + ((3:ℕ):ℝ) / ((27:ℕ):ℝ)) ^ (27 - 2 * 3 - 1) := by
    have h2 : (0:ℝ) < ((27:ℕ):ℝ) ^ (27 - 2 * 3 - 1) := by positivity
    have h3 : (0:ℝ) < (q + ((3:ℕ):ℝ) / ((27:ℕ):ℝ)) ^ (27 - 2 * 3 - 1) := pow_pos hqt _
    positivity
  rw [← hbridge] at hcert
  exact (mul_nonneg_iff_of_pos_left hA0).mp ((mul_nonneg_iff_of_pos_left hL).mp hcert)

