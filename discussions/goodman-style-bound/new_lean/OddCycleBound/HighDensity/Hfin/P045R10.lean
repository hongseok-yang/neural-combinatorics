theorem finKernel_45_10 {q l : ℝ} (hq0 : 0 ≤ q) (hq : q ≤ 1/3)
    (hl0 : 0 < l) (hlr : l < q + 10/45) :
    0 ≤ diagKernel 45 10 q l := by
  have hpos : (0:ℝ) ≤ ((45:ℤ):ℝ) * q + ((10:ℤ):ℝ) - ((45:ℤ):ℝ) * l := by
    push_cast; linarith [hlr]
  have hcert : 0 ≤ certReal (45:ℤ) (10:ℤ) 24 24 q l grid_45_10 :=
    certReal_nonneg (45:ℤ) (10:ℤ) 24 24 (by linarith) (by linarith) hl0.le hpos grid_45_10
  have hdata : eqBP (smulBP (26588814358957503287787 : ℤ) (dkClearedBP 45 10))
      (hornerBP (45:ℤ) (10:ℤ) 24 24 grid_45_10) = true := by
    decide +kernel
  have hbridge : bpEval q l (smulBP (26588814358957503287787 : ℤ) (dkClearedBP 45 10))
      = bpEval q l (hornerBP (45:ℤ) (10:ℤ) 24 24 grid_45_10) := eqBP_sound q l _ _ hdata
  rw [eval_smulBP, eval_dkClearedBP 45 10 (by norm_num) (by norm_num) q l,
      eval_hornerBP (45:ℤ) (10:ℤ) 24 24 q l grid_45_10] at hbridge
  have hqt : (0:ℝ) < q + ((10:ℕ):ℝ) / ((45:ℕ):ℝ) := by
    have : (0:ℝ) < ((10:ℕ):ℝ) / ((45:ℕ):ℝ) := by positivity
    linarith [hq0]
