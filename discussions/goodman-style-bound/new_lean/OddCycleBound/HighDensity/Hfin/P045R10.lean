  have hA0 : (0:ℝ) < ((10:ℕ):ℝ) * ((45:ℕ):ℝ) ^ (45 - 2 * 10 - 1)
      * (q + ((10:ℕ):ℝ) / ((45:ℕ):ℝ)) ^ (45 - 2 * 10 - 1) := by
    have h2 : (0:ℝ) < ((45:ℕ):ℝ) ^ (45 - 2 * 10 - 1) := by positivity
    have h3 : (0:ℝ) < (q + ((10:ℕ):ℝ) / ((45:ℕ):ℝ)) ^ (45 - 2 * 10 - 1) := pow_pos hqt _
