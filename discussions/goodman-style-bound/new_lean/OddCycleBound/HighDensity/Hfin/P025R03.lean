theorem finKernel_25_3 {q l : ℝ} (hq0 : 0 ≤ q) (hq : q ≤ 1/3)
    (hl0 : 0 < l) (hlr : l < q + 3/25) :
    0 ≤ diagKernel 25 3 q l := by
  have hpos : (0:ℝ) ≤ ((25:ℤ):ℝ) * q + ((3:ℤ):ℝ) - ((25:ℤ):ℝ) * l := by
    push_cast; linarith [hlr]
  have hcert : 0 ≤ certReal (25:ℤ) (3:ℤ) 18 18 q l grid_25_3 :=
    certReal_nonneg (25:ℤ) (3:ℤ) 18 18 (by linarith) (by linarith) hl0.le hpos grid_25_3
  have hdata : eqBP (smulBP (375847340910695493221282958984375 : ℤ) (dkClearedBP 25 3))
      (hornerBP (25:ℤ) (3:ℤ) 18 18 grid_25_3) = true := by
    decide +kernel
  have hbridge : bpEval q l (smulBP (375847340910695493221282958984375 : ℤ) (dkClearedBP 25 3))
      = bpEval q l (hornerBP (25:ℤ) (3:ℤ) 18 18 grid_25_3) := eqBP_sound q l _ _ hdata
  rw [eval_smulBP, eval_dkClearedBP 25 3 (by norm_num) (by norm_num) q l,
      eval_hornerBP (25:ℤ) (3:ℤ) 18 18 q l grid_25_3] at hbridge
  have hqt : (0:ℝ) < q + ((3:ℕ):ℝ) / ((25:ℕ):ℝ) := by
    have : (0:ℝ) < ((3:ℕ):ℝ) / ((25:ℕ):ℝ) := by positivity
    linarith [hq0]
  have hL : (0:ℝ) < ((375847340910695493221282958984375:ℤ):ℝ) := by norm_num
  have hA0 : (0:ℝ) < ((3:ℕ):ℝ) * ((25:ℕ):ℝ) ^ (25 - 2 * 3 - 1)
      * (q + ((3:ℕ):ℝ) / ((25:ℕ):ℝ)) ^ (25 - 2 * 3 - 1) := by
    have h2 : (0:ℝ) < ((25:ℕ):ℝ) ^ (25 - 2 * 3 - 1) := by positivity
    have h3 : (0:ℝ) < (q + ((3:ℕ):ℝ) / ((25:ℕ):ℝ)) ^ (25 - 2 * 3 - 1) := pow_pos hqt _
    positivity
  rw [← hbridge] at hcert
  exact (mul_nonneg_iff_of_pos_left hA0).mp ((mul_nonneg_iff_of_pos_left hL).mp hcert)

