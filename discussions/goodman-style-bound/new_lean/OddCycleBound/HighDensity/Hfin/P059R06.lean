    have h3 : (0:ℝ) < (q + ((6:ℕ):ℝ) / ((59:ℕ):ℝ)) ^ (59 - 2 * 6 - 1) := pow_pos hqt _
    positivity
  rw [← hbridge] at hcert
  exact (mul_nonneg_iff_of_pos_left hA0).mp ((mul_nonneg_iff_of_pos_left hL).mp hcert)

end OddCycleBound.HighDensity
