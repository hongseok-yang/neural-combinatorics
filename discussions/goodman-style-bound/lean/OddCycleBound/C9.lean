/-!
# The `C₉` path-certificate range (`paper.tex` §6.1)

The defect `Φ₉` decomposes by total degree in the spectral moments `s₀ … s₆` as `Φ₉ = L + Q + H`
(paper §6.1).  This file builds the positivity certificates for the three pieces and assembles
them into `cert9_specMoment : 0 ≤ Φ₉` (for `0 ≤ q ≤ 997/2000`), the analogue of `cert7_specMoment`.

The three pieces: the cubic/quartic part `H` (self-contained — uses only `s₀ ≥ 0` and the
`2×2` Hankel minor `s₀s₂ ≥ s₁²`), the linear part `L` (degree-6 `P_q`, `4×4` Gram `N_q`), and the
quadratic part `Q` (`3×3` Gram `M_q`), each via explicit SOS decompositions fed to `sos3`/`sos2`.
The assembled `C9_path_integral` is the complement-form `C₉` bound on the path-certificate range.
-/

open MeasureTheory

namespace OddCycleBound

variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
variable {U : Ω → Ω → ℝ}

/-- The `2×2` Hankel minor: `0 ≤ s₀(s₀s₂ − s₁²)`, i.e. `s₀s₂ ≥ s₁²` weighted by `s₀ ≥ 0`.
Instance of `sos1` with coefficients `(s₀, −s₁)`. -/
lemma hankel_minor_2 (hU : IsGraphon U μ) :
    0 ≤ specMoment U μ 0 ^ 2 * specMoment U μ 2 - specMoment U μ 0 * specMoment U μ 1 ^ 2 := by
  have h := sos1 hU (specMoment U μ 0) (-(specMoment U μ 1))
  nlinarith [h]

/-- **The cubic/quartic part `H ≥ 0`** (paper §6.1, Step 1).  Valid for all `q` (the binding
quadratic `512q²−576q+237` has negative discriminant), using only `s₀ ≥ 0` and `s₀s₂ ≥ s₁²`. -/
lemma cert9_H_specMoment (hU : IsGraphon U μ) (q : ℝ) :
    0 ≤ 8 * specMoment U μ 0 ^ 4 + 10 * (8 * q ^ 2 - 9 * q + 3) * specMoment U μ 0 ^ 3
      + 6 * (16 * q - 9) * specMoment U μ 0 ^ 2 * specMoment U μ 1
      + 24 * specMoment U μ 0 ^ 2 * specMoment U μ 2 + 24 * specMoment U μ 0 * specMoment U μ 1 ^ 2 := by
  have hs0 := specMoment_zero_nonneg hU
  have hmin := hankel_minor_2 hU
  have hdisc : (0 : ℝ) ≤ 512 * q ^ 2 - 576 * q + 237 := by nlinarith [sq_nonneg (16 * q - 9)]
  -- H ≥ 24·s₀·(s₀s₂−s₁²) + s₀·(completing square in s₁) + s₀³·(positive quadratic in q)
  nlinarith [mul_nonneg hs0 (sq_nonneg (16 * specMoment U μ 1 + (16 * q - 9) * specMoment U μ 0)),
    mul_nonneg (mul_nonneg hs0 hs0) (mul_nonneg hs0 hs0),
    mul_nonneg (mul_nonneg hs0 hs0) hs0,
    mul_nonneg hs0 hdisc, hmin, hs0,
    mul_nonneg (mul_nonneg hs0 hs0) hs0]

