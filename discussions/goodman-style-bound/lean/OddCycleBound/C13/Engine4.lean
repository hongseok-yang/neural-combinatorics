lemma sos4var3 (hU : IsGraphon U μ) (d0 d1 d2 d3 d4 d5 d6 d7 d8 d9 d10 d11 d12 d13 d14 : ℝ) :
    0 ≤ (d0^2) * (specMoment U μ 0 ^ 4) + (2*d0*d1 + 2*d0*d10 + 2*d0*d3 + 2*d0*d6) * (specMoment U μ 0 ^ 3 * specMoment U μ 1) + (2*d0*d14 + 2*d0*d2 + 2*d0*d5 + 2*d0*d9 + d1^2 + d10^2 + d3^2 + d6^2) * (specMoment U μ 0 ^ 3 * specMoment U μ 2) + (2*d1*d2 + 2*d10*d14 + 2*d3*d5 + 2*d6*d9) * (specMoment U μ 0 ^ 3 * specMoment U μ 3) + (d14^2 + d2^2 + d5^2 + d9^2) * (specMoment U μ 0 ^ 3 * specMoment U μ 4) + (2*d0*d11 + 2*d0*d12 + 2*d0*d13 + 2*d0*d4 + 2*d0*d7 + 2*d0*d8 + 2*d1*d10 + 2*d1*d3 + 2*d1*d6 + 2*d10*d3 + 2*d10*d6 + 2*d3*d6) * (specMoment U μ 0 ^ 2 * specMoment U μ 1 ^ 2) + (2*d1*d11 + 2*d1*d14 + 2*d1*d4 + 2*d1*d5 + 2*d1*d7 + 2*d1*d9 + 2*d10*d11 + 2*d10*d12 + 2*d10*d13 + 2*d10*d2 + 2*d10*d5 + 2*d10*d9 + 2*d12*d3 + 2*d13*d6 + 2*d14*d3 + 2*d14*d6 + 2*d2*d3 + 2*d2*d6 + 2*d3*d4 + 2*d3*d8 + 2*d3*d9 + 2*d5*d6 + 2*d6*d7 + 2*d6*d8) * (specMoment U μ 0 ^ 2 * specMoment U μ 1 * specMoment U μ 2) + (2*d11*d14 + 2*d11*d2 + 2*d12*d14 + 2*d12*d5 + 2*d13*d14 + 2*d13*d9 + 2*d2*d4 + 2*d2*d7 + 2*d4*d5 + 2*d5*d8 + 2*d7*d9 + 2*d8*d9) * (specMoment U μ 0 ^ 2 * specMoment U μ 1 * specMoment U μ 3) + (d11^2 + d12^2 + d13^2 + 2*d14*d2 + 2*d14*d5 + 2*d14*d9 + 2*d2*d5 + 2*d2*d9 + d4^2 + 2*d5*d9 + d7^2 + d8^2) * (specMoment U μ 0 ^ 2 * specMoment U μ 2 ^ 2) + (2*d1*d12 + 2*d1*d13 + 2*d1*d8 + 2*d10*d4 + 2*d10*d7 + 2*d10*d8 + 2*d11*d3 + 2*d11*d6 + 2*d12*d6 + 2*d13*d3 + 2*d3*d7 + 2*d4*d6) * (specMoment U μ 0 * specMoment U μ 1 ^ 3) + (2*d11*d12 + 2*d11*d13 + 2*d11*d4 + 2*d11*d5 + 2*d11*d7 + 2*d11*d9 + 2*d12*d13 + 2*d12*d2 + 2*d12*d4 + 2*d12*d8 + 2*d12*d9 + 2*d13*d2 + 2*d13*d5 + 2*d13*d7 + 2*d13*d8 + 2*d14*d4 + 2*d14*d7 + 2*d14*d8 + 2*d2*d8 + 2*d4*d7 + 2*d4*d8 + 2*d4*d9 + 2*d5*d7 + 2*d7*d8) * (specMoment U μ 0 * specMoment U μ 1 ^ 2 * specMoment U μ 2) + (2*d11*d8 + 2*d12*d7 + 2*d13*d4) * (specMoment U μ 1 ^ 4) := by
  have h := sos_sq_expand_4var hU (fun a b c e => if a = 0 then (if b = 0 then (if c = 0 then (if e = 0 then d0 else if e = 1 then d1 else if e = 2 then d2 else 0) else if c = 1 then (if e = 0 then d3 else if e = 1 then d4 else if e = 2 then 0 else 0) else if c = 2 then (if e = 0 then d5 else if e = 1 then 0 else if e = 2 then 0 else 0) else 0) else if b = 1 then (if c = 0 then (if e = 0 then d6 else if e = 1 then d7 else if e = 2 then 0 else 0) else if c = 1 then (if e = 0 then d8 else if e = 1 then 0 else if e = 2 then 0 else 0) else if c = 2 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else 0) else if b = 2 then (if c = 0 then (if e = 0 then d9 else if e = 1 then 0 else if e = 2 then 0 else 0) else if c = 1 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else if c = 2 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else 0) else 0) else  if a = 1 then (if b = 0 then (if c = 0 then (if e = 0 then d10 else if e = 1 then d11 else if e = 2 then 0 else 0) else if c = 1 then (if e = 0 then d12 else if e = 1 then 0 else if e = 2 then 0 else 0) else if c = 2 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else 0) else if b = 1 then (if c = 0 then (if e = 0 then d13 else if e = 1 then 0 else if e = 2 then 0 else 0) else if c = 1 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else if c = 2 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else 0) else if b = 2 then (if c = 0 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else if c = 1 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else if c = 2 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else 0) else 0) else  if a = 2 then (if b = 0 then (if c = 0 then (if e = 0 then d14 else if e = 1 then 0 else if e = 2 then 0 else 0) else if c = 1 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else if c = 2 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else 0) else if b = 1 then (if c = 0 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else if c = 1 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else if c = 2 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else 0) else if b = 2 then (if c = 0 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else if c = 1 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else if c = 2 then (if e = 0 then 0 else if e = 1 then 0 else if e = 2 then 0 else 0) else 0) else 0) else 0) 3
  simp (config := { maxSteps := 10000000 }) only [Finset.sum_range_succ, Finset.sum_range_zero] at h
