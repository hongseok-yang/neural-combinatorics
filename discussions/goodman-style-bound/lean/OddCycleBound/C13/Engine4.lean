import OddCycleBound.General.SumOfSquares

/-! # `C₁₃` L₄ four-fold SOS engine: `sos_sq_expand_4var` (the degree-4 `∫⁴(Σ C·hhhh)²` moment
identity) and the Newton-basis wrapper `sos4var3`. Generated by `cert_scripts/gen_engine.py`. -/

open MeasureTheory
namespace OddCycleBound
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
variable {U : Ω → Ω → ℝ}

/-- **The general four-variable product-measure SOS is PSD.**  For every `C : ℕ→ℕ→ℕ→ℕ→ℝ` and `N`,
`0 ≤ Σ C(a,b,c,g)·C(d,e,f,h)·s_{a+d}·s_{b+e}·s_{c+f}·s_{g+h}`, proved as
`0 ≤ ∫∫∫∫ (Σ C·hₐ(x)·h_b(y)·h_c(z)·h_g(w))²`.  The engine for the quartic (`C₁₃` L₄) kernel part. -/
lemma sos_sq_expand_4var (hU : IsGraphon U μ) (C : ℕ → ℕ → ℕ → ℕ → ℝ) (N : ℕ) :
    0 ≤ ∑ g ∈ Finset.range N, ∑ h ∈ Finset.range N, ∑ c ∈ Finset.range N, ∑ f ∈ Finset.range N,
          ∑ b ∈ Finset.range N, ∑ e ∈ Finset.range N, ∑ a ∈ Finset.range N, ∑ dd ∈ Finset.range N,
          C a b c g * C dd e f h *
            (specMoment U μ (a + dd) * specMoment U μ (b + e) * specMoment U μ (c + f) * specMoment U μ (g + h)) := by
  have hgx : ∀ b c g, Good (fun x => ∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) :=
    fun b c g => good_momcombo hU (fun a => C a b c g) N
  set F : Ω → ℝ := fun x => ∫ y, ∫ z, ∫ w, (∑ g ∈ Finset.range N,
      (∑ c ∈ Finset.range N, (∑ b ∈ Finset.range N,
        (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) * compressIter U μ b y)
        * compressIter U μ c z) * compressIter U μ g w) ^ 2 ∂μ ∂μ ∂μ with hF
  have hFnn : ∀ x, 0 ≤ F x :=
    fun x => integral_nonneg fun y => integral_nonneg fun z => integral_nonneg fun w => sq_nonneg _
  have hFeq : ∀ x, F x = ∑ g ∈ Finset.range N, ∑ h ∈ Finset.range N, ∑ c ∈ Finset.range N,
      ∑ f ∈ Finset.range N, ∑ b ∈ Finset.range N, ∑ e ∈ Finset.range N,
        (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x)
          * (∑ dd ∈ Finset.range N, C dd e f h * compressIter U μ dd x)
          * (specMoment U μ (b + e) * (specMoment U μ (c + f) * specMoment U μ (g + h))) := by
    intro x
    have hzw : ∀ y, (∫ z, ∫ w, (∑ g ∈ Finset.range N,
          (∑ c ∈ Finset.range N, (∑ b ∈ Finset.range N,
            (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) * compressIter U μ b y)
            * compressIter U μ c z) * compressIter U μ g w) ^ 2 ∂μ ∂μ)
        = ∑ g ∈ Finset.range N, ∑ h ∈ Finset.range N, ∑ c ∈ Finset.range N, ∑ f ∈ Finset.range N,
          (∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) * compressIter U μ b y)
          * (∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b f h * compressIter U μ a x) * compressIter U μ b y)
          * (specMoment U μ (c + f) * specMoment U μ (g + h)) := by
      intro y
      have hw : ∀ z, (∫ w, (∑ g ∈ Finset.range N,
            (∑ c ∈ Finset.range N, (∑ b ∈ Finset.range N,
              (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) * compressIter U μ b y)
              * compressIter U μ c z) * compressIter U μ g w) ^ 2 ∂μ)
          = ∑ g ∈ Finset.range N, ∑ h ∈ Finset.range N,
            (∑ c ∈ Finset.range N, (∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) * compressIter U μ b y) * compressIter U μ c z)
            * (∑ c ∈ Finset.range N, (∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b c h * compressIter U μ a x) * compressIter U μ b y) * compressIter U μ c z)
            * specMoment U μ (g + h) := fun z =>
        momsq_expand hU (fun g => ∑ c ∈ Finset.range N, (∑ b ∈ Finset.range N,
          (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) * compressIter U μ b y) * compressIter U μ c z) N
      show (∫ z, (∫ w, _ ∂μ) ∂μ) = _
      rw [integral_congr_ae (ae_of_all _ hw)]
      have hgz : ∀ g, Good (fun z => ∑ c ∈ Finset.range N, (∑ b ∈ Finset.range N,
          (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) * compressIter U μ b y) * compressIter U μ c z) :=
        fun g => good_momcombo hU (fun c => ∑ b ∈ Finset.range N,
          (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) * compressIter U μ b y) N
      have hIntz : ∀ g h, Integrable (fun z =>
          (∑ c ∈ Finset.range N, (∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) * compressIter U μ b y) * compressIter U μ c z)
          * (∑ c ∈ Finset.range N, (∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b c h * compressIter U μ a x) * compressIter U μ b y) * compressIter U μ c z)
          * specMoment U μ (g + h)) μ :=
        fun g h => (((hgz g).mul (hgz h)).integrable).mul_const _
      rw [integral_finsetSum _ (fun g _ => integrable_finsetSum _ (fun h _ => hIntz g h))]
      refine Finset.sum_congr rfl fun g _ => ?_
      rw [integral_finsetSum _ (fun h _ => hIntz g h)]
      refine Finset.sum_congr rfl fun h _ => ?_
      rw [show (fun z => (∑ c ∈ Finset.range N, (∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) * compressIter U μ b y) * compressIter U μ c z)
            * (∑ c ∈ Finset.range N, (∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b c h * compressIter U μ a x) * compressIter U μ b y) * compressIter U μ c z)
            * specMoment U μ (g + h))
          = (fun z => specMoment U μ (g + h) * ((∑ c ∈ Finset.range N, (∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) * compressIter U μ b y) * compressIter U μ c z)
            * (∑ c ∈ Finset.range N, (∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b c h * compressIter U μ a x) * compressIter U μ b y) * compressIter U μ c z))) from by funext z; ring,
        integral_const_mul,
        mombilin_expand hU (fun c => ∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) * compressIter U μ b y)
          (fun c => ∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b c h * compressIter U μ a x) * compressIter U μ b y) N, Finset.mul_sum]
      refine Finset.sum_congr rfl fun c _ => ?_
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun f _ => by ring
    show (∫ y, (∫ z, ∫ w, _ ∂μ ∂μ) ∂μ) = _
    rw [integral_congr_ae (ae_of_all _ hzw)]
    have hgy : ∀ c g, Good (fun y => ∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) * compressIter U μ b y) :=
      fun c g => good_momcombo hU (fun b => ∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) N
    have hInty : ∀ g h c f, Integrable (fun y =>
        (∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) * compressIter U μ b y)
        * (∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b f h * compressIter U μ a x) * compressIter U μ b y)
        * (specMoment U μ (c + f) * specMoment U μ (g + h))) μ :=
      fun g h c f => (((hgy c g).mul (hgy f h)).integrable).mul_const _
    rw [integral_finsetSum _ (fun g _ => integrable_finsetSum _ (fun h _ =>
      integrable_finsetSum _ (fun c _ => integrable_finsetSum _ (fun f _ => hInty g h c f))))]
    refine Finset.sum_congr rfl fun g _ => ?_
    rw [integral_finsetSum _ (fun h _ => integrable_finsetSum _ (fun c _ => integrable_finsetSum _ (fun f _ => hInty g h c f)))]
    refine Finset.sum_congr rfl fun h _ => ?_
    rw [integral_finsetSum _ (fun c _ => integrable_finsetSum _ (fun f _ => hInty g h c f))]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [integral_finsetSum _ (fun f _ => hInty g h c f)]
    refine Finset.sum_congr rfl fun f _ => ?_
    rw [show (fun y => (∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) * compressIter U μ b y)
          * (∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b f h * compressIter U μ a x) * compressIter U μ b y)
          * (specMoment U μ (c + f) * specMoment U μ (g + h)))
        = (fun y => (specMoment U μ (c + f) * specMoment U μ (g + h)) * ((∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x) * compressIter U μ b y)
          * (∑ b ∈ Finset.range N, (∑ a ∈ Finset.range N, C a b f h * compressIter U μ a x) * compressIter U μ b y))) from by funext y; ring,
      integral_const_mul,
      mombilin_expand hU (fun b => ∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x)
        (fun b => ∑ a ∈ Finset.range N, C a b f h * compressIter U μ a x) N, Finset.mul_sum]
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun e _ => by ring
  have hIntx : ∀ g h c f b e, Integrable (fun x =>
      (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x)
      * (∑ dd ∈ Finset.range N, C dd e f h * compressIter U μ dd x)
      * (specMoment U μ (b + e) * (specMoment U μ (c + f) * specMoment U μ (g + h)))) μ :=
    fun g h c f b e => (((hgx b c g).mul (hgx e f h)).integrable).mul_const _
  have key : ∫ x, F x ∂μ = ∑ g ∈ Finset.range N, ∑ h ∈ Finset.range N, ∑ c ∈ Finset.range N,
      ∑ f ∈ Finset.range N, ∑ b ∈ Finset.range N, ∑ e ∈ Finset.range N, ∑ a ∈ Finset.range N, ∑ dd ∈ Finset.range N,
        C a b c g * C dd e f h *
          (specMoment U μ (a + dd) * specMoment U μ (b + e) * specMoment U μ (c + f) * specMoment U μ (g + h)) := by
    rw [integral_congr_ae (ae_of_all _ hFeq)]
    rw [integral_finsetSum _ (fun g _ => integrable_finsetSum _ (fun h _ => integrable_finsetSum _ (fun c _ =>
      integrable_finsetSum _ (fun f _ => integrable_finsetSum _ (fun b _ => integrable_finsetSum _ (fun e _ => hIntx g h c f b e))))))]
    refine Finset.sum_congr rfl fun g _ => ?_
    rw [integral_finsetSum _ (fun h _ => integrable_finsetSum _ (fun c _ => integrable_finsetSum _ (fun f _ => integrable_finsetSum _ (fun b _ => integrable_finsetSum _ (fun e _ => hIntx g h c f b e)))))]
    refine Finset.sum_congr rfl fun h _ => ?_
    rw [integral_finsetSum _ (fun c _ => integrable_finsetSum _ (fun f _ => integrable_finsetSum _ (fun b _ => integrable_finsetSum _ (fun e _ => hIntx g h c f b e))))]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [integral_finsetSum _ (fun f _ => integrable_finsetSum _ (fun b _ => integrable_finsetSum _ (fun e _ => hIntx g h c f b e)))]
    refine Finset.sum_congr rfl fun f _ => ?_
    rw [integral_finsetSum _ (fun b _ => integrable_finsetSum _ (fun e _ => hIntx g h c f b e))]
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [integral_finsetSum _ (fun e _ => hIntx g h c f b e)]
    refine Finset.sum_congr rfl fun e _ => ?_
    rw [show (fun x => (∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x)
          * (∑ dd ∈ Finset.range N, C dd e f h * compressIter U μ dd x)
          * (specMoment U μ (b + e) * (specMoment U μ (c + f) * specMoment U μ (g + h))))
        = (fun x => (specMoment U μ (b + e) * (specMoment U μ (c + f) * specMoment U μ (g + h))) * ((∑ a ∈ Finset.range N, C a b c g * compressIter U μ a x)
          * (∑ dd ∈ Finset.range N, C dd e f h * compressIter U μ dd x))) from by funext x; ring,
      integral_const_mul, mombilin_expand hU (fun a => C a b c g) (fun dd => C dd e f h) N, Finset.mul_sum]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun dd _ => by ring
  rw [← key]; exact integral_nonneg hFnn


