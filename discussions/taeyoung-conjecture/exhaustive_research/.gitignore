# Lean verification artifacts
#
# These files are intentionally kept out of Git.  They are deterministic
# outputs of the preparation scripts and are needed only in a local checkout.
# Regenerate the S4 campaign with:
#
#   python experiments/prepare_all_s4_lean.py
#
# Regenerate the Atlas 43 JSON and bounded-memory leaves with:
#
#   python experiments/export_atlas43_lean_data.py
#   python experiments/export_atlas43_lean_gram.py
#   python experiments/export_atlas43_raw_group_witness.py
#   python experiments/generate_atlas43_lean_checks.py

# Temporary certificate-reduction probes.
/experiments/reduction_probe/

# Atlas 43 JSON exports (the rational certificate input remains tracked).
/experiments/house_atlas43_lean_classification.json
/experiments/house_atlas43_lean_gram.json
/experiments/house_atlas43_raw_group_witness.json

# Per-certificate S4 sidecars and target lists.
/experiments/atlas*_lean_certificate*.json
/experiments/atlas*_lean_certificate*_targets.txt

# Shared S4 sidecars and target lists.
/experiments/s4_lean_common*.json
/experiments/s4_lean_classification_manifest*.json
/experiments/s4_lean_*targets.txt

# Local campaign state and preparation reports.
/experiments/s4_lean_campaign.json
/experiments/s4_lean_campaign_summary.txt
/experiments/s4_lean_preparation.log
/experiments/s4_lean_preparation_report.json

# S4 Lean modules emitted by the preparation scripts.
/lean/Taeyoung/Methods/RootedSOS/S4Atlas*.lean
/lean/Taeyoung/Methods/RootedSOS/S4Classification*.lean
/lean/Taeyoung/Methods/RootedSOS/S4YoungSparse*.lean
/lean/Taeyoung/Methods/RootedSOS/S4YoungPullback*.lean
/lean/Taeyoung/Methods/RootedSOS/S4YoungPullPart*.lean
/lean/Taeyoung/Methods/RootedSOS/S4YoungPullFull*.lean

# The Atlas 43 leaf checks (Atlas43*Cell*, Atlas43*Row*, Atlas43*Checks.lean,
# Atlas43RawGroups.lean) were emitted by
# experiments/generate_atlas43_lean_checks.py and are tracked since the chain's
# sequential verification on 2026-09-22; see lean/verification_runs/atlas43/.
